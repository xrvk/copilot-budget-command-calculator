# Local dev credentials for import prefill (Budget Planner, Tier Planner).
# Copy this file to .env.local — it will be gitignored automatically.
#
#   cp .env.local.example .env.local

# ── Live API credentials ─────────────────────────────────────────
# Pre-fills the Import panel and auto-connects on page load.
# Without these, the app starts in demo mode with sample data.
VITE_DEV_ENTERPRISE_URL=https://github.com/enterprises/your-slug
VITE_DEV_PAT=ghp_your_classic_pat_here
