{
    "name": "copilot-budget-command-calculator",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "predev": "if [ -f scripts/ensure-worktree-links.sh ]; then bash scripts/ensure-worktree-links.sh; fi",
        "dev": "vite",
        "setup": "if [ -f scripts/setup-hooks.sh ]; then bash scripts/setup-hooks.sh; else echo 'scripts/ not found (expected in development repo only)'; fi",
        "kill": "fuser -k 5000/tcp",
        "prebuild": "if [ -f scripts/ensure-worktree-links.sh ]; then bash scripts/ensure-worktree-links.sh; fi",
        "build": "tsc -b --noCheck && vite build",
        "prebuild:ccc-tips": "if [ -f scripts/ensure-worktree-links.sh ]; then bash scripts/ensure-worktree-links.sh; fi",
        "build:ccc-tips": "cd packages/ccc-tips && npx vite build --config vite.config.ts",
        "prelint": "if [ -f scripts/ensure-worktree-links.sh ]; then bash scripts/ensure-worktree-links.sh; fi",
        "lint": "eslint .",
        "optimize": "vite optimize",
        "preview": "vite preview",
        "pretest": "if [ -f scripts/ensure-worktree-links.sh ]; then bash scripts/ensure-worktree-links.sh; fi",
        "test": "vitest run",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@copilot-budget/calculator-core": "*",
        "@phosphor-icons/react": "^2.1.7",
        "@radix-ui/colors": "^3.0.0",
        "@radix-ui/react-alert-dialog": "^1.1.6",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-popover": "^1.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.1.2",
        "@radix-ui/react-switch": "^1.1.3",
        "@radix-ui/react-tabs": "^1.1.3",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@tailwindcss/vite": "^4.2.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.14.0",
        "next-themes": "^0.4.6",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-error-boundary": "^6.1.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.5.0",
        "tw-animate-css": "^1.2.4",
        "zod": "^4.4.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react-swc": "^4.3.0",
        "eslint": "^10.2.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.5.0",
        "happy-dom": "^20.9.0",
        "tailwindcss": "^4.2.4",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.59.1",
        "vite": "^8.0.10",
        "vitest": "^4.1.5"
    },
    "workspaces": {
        "packages": [
            "packages/*"
        ]
    }
}
